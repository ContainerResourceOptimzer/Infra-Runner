{
  "title": "Optimizer SLA Overview",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "tags": ["optimizer", "k6"],
  "templating": {
    "list": [
      {
        "name": "exp",
        "label": "Experiment",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(k6_http_reqs_total, experiment)",
        "refresh": 2,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "job",
        "label": "Job Container",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(k6_http_reqs_total{experiment=\"$exp\"}, container)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Job SLA Summary",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 12 },
      "datasource": "Prometheus",
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "container" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "Time": true,
              "expected_response": true,
              "experiment": true,
              "group": true,
              "method": true,
              "name": true,
              "proto": true,
              "scenario": true,
              "status": true,
              "url": true,
              "error_code": true
            },
            "renameByName": {
              "container": "Job",
              "Value": "Requests",
              "Value #A": "Requests",
              "Value #B": "p95 (s)",
              "Value #C": "Failed %"
            },
            "indexByName": {
              "Job": 0,
              "Requests": 1,
              "p95 (s)": 2,
              "Failed %": 3
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (max_over_time(k6_http_reqs_total{experiment=\"$exp\", container=~\"$job\"}[$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (container) (increase(k6_http_req_duration_seconds{experiment=\"$exp\", container=~\"$job\"}[$__range])))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "sum by (container) (max_over_time(k6_http_reqs_total{experiment=\"$exp\", container=~\"$job\", expected_response=\"false\"}[$__range])) / sum by (container) (max_over_time(k6_http_reqs_total{experiment=\"$exp\", container=~\"$job\"}[$__range])) * 100",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "displayName", "value": "p95 (s)" }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "C" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "displayName", "value": "Failed %" }
            ]
          }
        ]
      }
    }
  ]
}
